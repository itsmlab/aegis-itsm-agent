# ── AEGIS SaaS — Caddyfile ──────────────────────────────────
# Reverse proxy with automatic HTTPS via Let's Encrypt.
# Set CADDY_DOMAIN env var to your domain (e.g., aegis.example.com).
# For local development, CADDY_DOMAIN defaults to localhost (no TLS).

{$CADDY_DOMAIN:localhost} {
    # Reverse proxy to the AEGIS app
    reverse_proxy {$AEGIS_UPSTREAM:app:8000}

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Logs
    log {
        output file /data/logs/access.log
        format json
    }
}
