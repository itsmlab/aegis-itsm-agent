# ── AEGIS Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values

# ── LLM Provider ─────────────────────────────────────────────
# Options: "deepseek", "openai", "ollama"
LLM_PROVIDER=deepseek

# DeepSeek (default)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI (alternative)
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Ollama (local, for on-premise)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── PostgreSQL (required for SaaS multi-tenant) ──────────────
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aegis

# ── ChromaDB ─────────────────────────────────────────────────
# Set CHROMA_USE_SERVER=true to use ChromaDB in client-server mode
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# CHROMA_USE_SERVER=false

# ── Multi-tenancy ────────────────────────────────────────────
# DEFAULT_TENANT_ID=default
# AUTH_REQUIRED=false

# ── Slack Bot (required for slack_bot.py) ────────────────────
# Create a Slack app at https://api.slack.com/apps
# Enable Socket Mode, add Bot Token Scopes, install to workspace
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token
